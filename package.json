{
  "name": "@dev-flow-tech/mcp-server",
  "version": "4.20.0",
  "description": "MCP Server for DevFlow - Claude Code Integration",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "devflow-mcp": "dist/index.js",
    "devflow-mcp-setup": "dist/setup/setup.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:tsc": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node dist/setup/setup.js",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:check": "node scripts/check-versions.js",
    "version:bump": "node scripts/bump-version.js",
    "publish:npm": "npm run version:check && npm run build && npm publish"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KlausFreiberufler/devflow-mcp.git"
  },
  "keywords": [
    "devflow",
    "mcp",
    "claude-code",
    "ai-development"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
