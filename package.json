{
  "name": "@dev-flow-tech/mcp-server",
  "version": "4.31.0",
  "description": "MCP Server for DevFlow - Claude Code Integration",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "packages/skills/skills",
    "packages/skills/index.json",
    "packages/skills/package.json",
    "packages/skills/README.md",
    "skills",
    ".codex-plugin/plugin.json",
    ".codex-plugin/.mcp.json",
    ".codex-plugin/hooks/",
    ".codex-plugin/README.md",
    ".codex-plugin/assets/",
    ".gemini-extension/gemini-extension.json",
    ".gemini-extension/GEMINI.md",
    ".gemini-extension/hooks/",
    ".gemini-extension/README.md",
    ".cursor/rules/",
    ".cursor/mcp.json",
    ".cursor/hooks.json",
    ".cursor/hooks/",
    ".cursor/README.md",
    "scripts/setup-cursor.sh",
    "scripts/check-active-flow.sh",
    "scripts/pre-flow-update-knowledge-auto-resolve.js",
    "scripts/pre-flow-update-self-approval.js",
    "scripts/post-flow-update.js",
    "scripts/check-plugin-update.js",
    "scripts/session-start-info.sh",
    "scripts/stop-check.js",
    "scripts/lib/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "devflow-mcp": "dist/index.js",
    "devflow-mcp-flows": "dist/index-flows.js",
    "devflow-mcp-wiki": "dist/index-wiki.js",
    "devflow-mcp-setup": "dist/setup/setup.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:tsc": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node dist/setup/setup.js",
    "prepare": "npm run build",
    "test": "vitest run && npm run build:codex-plugin && npm run build:gemini-extension && npm run build:cursor-bundle && node --test packages/skills/__tests__/skill-schema.test.js __tests__/server-split.test.js __tests__/codex-plugin.test.js __tests__/gemini-extension.test.js __tests__/cursor-bundle.test.js scripts/tests/hooks-matcher.test.js scripts/tests/pre-flow-update-suffix-match.test.js scripts/tests/post-flow-update.test.js scripts/tests/version-check-lib.test.js scripts/tests/check-plugin-update.test.js scripts/tests/session-start-config.test.js",
    "test:watch": "vitest",
    "skills:build-index": "node packages/skills/scripts/build-index.js",
    "build:codex-plugin": "node scripts/build-codex-plugin.js",
    "build:gemini-extension": "node scripts/build-gemini-extension.js",
    "build:cursor-bundle": "node scripts/build-cursor-bundle.js",
    "version:check": "node scripts/check-versions.js",
    "version:bump": "node scripts/bump-version.js",
    "publish:npm": "npm run version:check && npm run build && npm publish"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KlausFreiberufler/devflow-mcp.git"
  },
  "keywords": [
    "devflow",
    "mcp",
    "claude-code",
    "ai-development"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
