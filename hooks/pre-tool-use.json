{
  "hooks": [
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-active-flow.sh"
        }
      ]
    },
    {
      "matcher": ".*__flow_create$",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-create-validate.js"
        }
      ]
    },
    {
      "matcher": ".*__flow_update$",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-knowledge-auto-resolve.js"
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-adr-compliance.js"
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-plan-critic.js"
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-code-critic.js"
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-self-approval.js"
        }
      ]
    }
  ]
}
