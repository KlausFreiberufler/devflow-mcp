{
  "hooks": [
    {
      "matcher": "Edit|Write|NotebookEdit",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-active-flow.sh"
        }
      ]
    },
    {
      "matcher": "mcp__devflow__flow_update",
      "hooks": [
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-knowledge-auto-resolve.js"
        },
        {
          "type": "command",
          "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pre-flow-update-self-approval.js"
        }
      ]
    }
  ]
}
