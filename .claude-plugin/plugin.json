      "sensitive": false
    }
  },
  "mcpServers": {
    "devflow": {
      "command": "npx",
      "args": ["-y", "-p", "@dev-flow-tech/mcp-server@4.9.0", "devflow-mcp"],
      "env": {}
    }
  }
}
