{
  "name": "devflow",
  "version": "1.0.0",
  "description": "Structured AI development workflows with enforced planning, task tracking, and code review gates — Gemini CLI extension",
  "author": {
    "name": "DevFlow",
    "url": "https://dev-flow.tech"
  },
  "homepage": "https://dev-flow.tech",
